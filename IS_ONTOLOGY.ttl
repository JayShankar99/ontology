###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#address
:address rdf:type owl:DatatypeProperty ;
         rdfs:domain :Person ;
         rdfs:range xsd:string .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#age
:age rdf:type owl:DatatypeProperty ;
     rdfs:domain :Person ;
     rdfs:range xsd:int .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#alias
:alias rdf:type owl:DatatypeProperty ;
       rdfs:domain :Person ;
       rdfs:range xsd:string .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#date
:date rdf:type owl:DatatypeProperty ;
      rdfs:domain :Date ;
      rdfs:range xsd:dateTime .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#hs
:hs rdf:type owl:DatatypeProperty ;
    rdfs:domain :Person ;
    rdfs:range xsd:string ;
    rdfs:comment "history sheeter" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#name
:name rdf:type owl:DatatypeProperty ;
      rdfs:domain :District ,
                  :Location ,
                  :Person ,
                  :PoliceStation ,
                  :SubType ,
                  :Type ,
                  :Zone ;
      rdfs:range xsd:string .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#note
:note rdf:type owl:DatatypeProperty ;
      rdfs:domain :Case ;
      rdfs:range xsd:string ;
      rdfs:comment "case description" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#section
:section rdf:type owl:DatatypeProperty ;
         rdfs:domain :Case ;
         rdfs:range xsd:string ;
         rdfs:comment "section applied eg. (ipc sections)" .


