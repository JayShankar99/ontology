#    Classes
#################################################################

###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#Case
:Case rdf:type owl:Class ;
      rdfs:comment "case details" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#Date
:Date rdf:type owl:Class ;
      rdfs:comment "Date" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#District
:District rdf:type owl:Class ;
          rdfs:comment "District name" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#Location
:Location rdf:type owl:Class ;
          rdfs:comment "It can be any location eg. location of crime, location of incident." .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#Organization
:Organization rdf:type owl:Class ;
              rdfs:comment "Organization" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#Person
:Person rdf:type owl:Class ;
        rdfs:comment """All person details maintioned in the document:
if it is a criminal the below are the data we are able to pull:
1. Name
2. Age
3. Address
4. hs (history sheeter)

any person apart form the Criminal we only have the \"name\" as property for that person.""" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#PoliceStation
:PoliceStation rdf:type owl:Class ;
               rdfs:comment "Police station name" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#SubType
:SubType rdf:type owl:Class ;
         rdfs:comment "crime subtype" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#Type
:Type rdf:type owl:Class ;
      rdfs:comment "Crime type (eg. Rowdysm)" .


###  http://www.semanticweb.org/jaysh/ontologies/2025/4/IS_Ontology#Zone
:Zone rdf:type owl:Class ;
      rdfs:comment "Zone name, like north zone, south zone etc." .


